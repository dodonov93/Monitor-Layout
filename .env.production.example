# Production Environment Configuration for Oracle Cloud VM
# Copy this file to .env.production and fill in your values

# ============================================
# Authentication Configuration
# ============================================
# Generate a secure random string (e.g., openssl rand -base64 32)
BETTER_AUTH_SECRET=your-secure-random-string-here

# Your production domain (with https://)
BETTER_AUTH_URL=https://your-domain.com

# ============================================
# Admin Configuration
# ============================================
ADMIN_EMAIL=capital93@gmail.com
ADMIN_PASSWORD=your-secure-admin-password-here

# ============================================
# Database Configuration
# ============================================
# For local SQLite on Oracle VM, use file path
TURSO_DATABASE_URL=file:/opt/monitor-layout/data/monitor-layout.db

# No auth token needed for local SQLite
# TURSO_AUTH_TOKEN=

# ============================================
# Node Environment
# ============================================
NODE_ENV=production
PORT=3000
